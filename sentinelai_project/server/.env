PORT=4000
NODE_ENV=development
JWT_SECRET=104a514c852363a427258c1c345047063206f5f230f08f3c1aadaf3d79391288

# Which AI provider powers explanations/chat. 'gemini' (default) has a
# usable free tier; 'anthropic' requires paid credits. Switching later is
# just changing this value — no code changes needed.
AI_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6IMGmsDlP47O56zm0bCCDM8y_Ylzz1Ao8K5J65JJclgyA
GEMINI_MODEL=gemini-3.6-flash

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed frontend origins for CORS in production.
# Leave unset in development to allow any origin.
ALLOWED_ORIGINS=

# How often (minutes) the continuous-monitoring scheduler re-scans assets
# that have auto-scan enabled. Proposal describes this as "24/7 monitoring" —
# in a real deployment this would typically be every 15-60 minutes.
SCAN_INTERVAL_MINUTES=60

# Set to "true" to disable the background scheduler (useful for tests/CI).
DISABLE_SCHEDULER=false

LOG_LEVEL=info

# Encrypts stored cloud provider credentials (e.g. AWS keys) at rest.
# Must decode to exactly 32 bytes — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left unset, a key is derived from JWT_SECRET as a fallback so the app
# still runs in development — but set this explicitly before connecting
# any real cloud account. Rotating JWT_SECRET without this set would also
# make previously-stored cloud credentials undecryptable.
CREDENTIAL_ENCRYPTION_KEY=4da3e8e0c1b33387bbf1b8c5c90831dc91aca950fe501ba9fd05cb53f8e9d9bd
